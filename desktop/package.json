{
  "name": "oxys-restaurante-desktop",
  "productName": "Oxys Restaurante",
  "version": "1.0.2",
  "description": "Oxys Restaurante para Windows, Mac e Linux",
  "author": "Oxys Sistemas <oxyssistemas@gmail.com>",
  "homepage": "https://www.oxysrestaurante.app",
  "private": true,
  "main": "main.cjs",
  "desktopName": "oxys-restaurante.desktop",
  "scripts": {
    "start": "electron .",
    "icons": "python3 build/make-icons.py",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "release": "electron-builder --publish always",
    "dist:linux": "electron-builder --linux",
    "offline-ui": "node -e \"const fs=require('fs');fs.rmSync('offline-ui',{recursive:true,force:true});fs.cpSync('../dist','offline-ui',{recursive:true})\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.oxysrestaurante.desktop",
    "productName": "Oxys Restaurante",
    "copyright": "Oxys Sistemas",
    "files": [
      "main.cjs",
      "preload.cjs",
      "offline.html",
      "build/icon.png",
      "hub/**/*",
      "offline-ui/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "oxyssistemas",
        "repo": "PDV_Restaurante-Construcao",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Oxys-Restaurante-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Oxys Restaurante",
      "language": "1046"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.business",
      "artifactName": "Oxys-Restaurante-Mac.${ext}",
      "hardenedRuntime": true
    },
    "dmg": {
      "title": "Oxys Restaurante"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Office",
      "maintainer": "Oxys Sistemas <oxyssistemas@gmail.com>",
      "synopsis": "Sistema para restaurantes",
      "artifactName": "Oxys-Restaurante-Linux.${ext}",
      "executableName": "oxys-restaurante",
      "syncDesktopName": true
    },
    "deb": {
      "packageName": "oxys-restaurante"
    }
  }
}
